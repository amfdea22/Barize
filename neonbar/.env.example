# barize - Configuração
# Copie este arquivo para .env e preencha os valores

# ─── Database ──────────────────────────────
POSTGRES_USER=barize
POSTGRES_PASSWORD=suasenhaaqui
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=barize

# ─── Segurança ─────────────────────────────
JWT_SECRET=suachavesecretaaqui (minimo 16 caracteres)

# ─── CORS ──────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Ambiente ──────────────────────────────
# DEBUG=true
# LOG_LEVEL=DEBUG

# ─── Opcional: Override para SQLite (dev) ──
# DATABASE_URL=sqlite:///./barize.db
