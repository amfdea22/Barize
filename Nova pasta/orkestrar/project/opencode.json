{
  "$schema": "https://opencode.ai/config.json",
  "projectType": "user",
  "harnessPath": "..",
  "default_agent": "build",
  "instructions": [
    "orkestrar/AGENTS.md",
    "../.opencode/agents/build.md",
    "../.opencode/rules/workflow-deterministico.md",
    "../.opencode/rules/guardrails.md",
    "../.opencode/rules/diretrizes-gerais.md",
    "../.opencode/rules/padroes-codigo.md",
    "../.opencode/rules/memoria-persistente.md",
    "../.opencode/rules/sdd.md",
    "../.opencode/rules/smallspec.md",
    "../.opencode/rules/context-engineering.md"
  ],
  "permission": {
    "edit": "allow",
    "bash: *": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 5,
    "reserved": 10000
  },
  "experimental": {
    "primary_tools": ["edit", "write"]
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 40000
  }
}
